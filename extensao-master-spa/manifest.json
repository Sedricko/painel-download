{
  "manifest_version": 3,
  "name": "Master SPA",
  "version": "0.1.0",
  "description": "Mapeia o DOM (com componentes React) e as chamadas fetch/XHR de uma SPA, exporta JSON e abre um painel de acoes.",
  "permissions": ["scripting", "activeTab", "downloads"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html", "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["scripts/inject_network.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["scripts/inject_scanner.js"], "run_at": "document_idle", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["scripts/content_manager.js"], "run_at": "document_idle" }
  ]
}
